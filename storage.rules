rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 카드 이미지: 누구나 읽기, 관리자만 업로드
    match /cards/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /packs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
